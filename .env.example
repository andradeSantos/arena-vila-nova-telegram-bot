# Configuracoes do Bot de Atendimento da Arena Vila Nova
# Copie este arquivo para .env e preencha suas chaves

# Chave da API do Google Gemini (opcional para modo offline deterministico; obrigatoria para LLM online)
GEMINI_API_KEY=
# Token do Bot do Telegram (obtido via @BotFather para o Bloco 3)
TELEGRAM_BOT_TOKEN=

# Porta do servidor HTTP Backend
PORT=8000

# Modelos padrao do Google Gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
